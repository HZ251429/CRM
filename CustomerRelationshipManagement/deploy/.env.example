# Copy to deploy/.env on the server and fill in. Never commit .env (it is git-ignored).

# The address of the app, without https:// (point its DNS A record at the server first)
DOMAIN=crm.example.com
# Let's Encrypt sends certificate notices here
ACME_EMAIL=you@example.com

# Database password: long and random, e.g. from:  openssl rand -base64 32
DB_PASSWORD=

# Super admin login, used only on the first start to create the platform owner's account.
CRM_SUPERADMIN_USERNAME=superadmin
# Super admin password, used only on the first start.
# Use a long unique password (up to 72 characters). Changing it here later has no effect: see deploy/README.md.
CRM_SUPERADMIN_PASSWORD=

# WhatsApp (Meta Cloud API). Leave empty until the Meta app is ready; see README "Connecting WhatsApp".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# language code of your approved templates (en, en_US, ...)
WHATSAPP_TEMPLATE_LANGUAGE=en
# the test chat on the WhatsApp page; set to false once the real number works
WHATSAPP_TEST_CHAT=true

# Optional
# TZ=Asia/Kolkata
# JAVA_OPTS=-Xmx768m -XX:+ExitOnOutOfMemoryError
# DDL_AUTO=update
